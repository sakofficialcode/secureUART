    "scan_out" Out;
}
SignalGroups {
    "_si" = '"scan_in"' {
        ScanIn;
    }
    "_so" = '"scan_out"' {
        ScanOut;
    }
    "_clk" = '"clk"';
    "all_inputs" = '"bist_start" + "clk" + "key_in" + "key_load" + "key_sel" + 
    "rst_n" + "scan_en" + "tx_data[0]" + "tx_data[1]" + "tx_data[2]" + 
    "tx_data[3]" + "tx_data[4]" + "tx_data[5]" + "tx_data[6]" + "tx_data[7]" + 
    "tx_valid" + "uart_rxd" + "scan_in"';
    "all_outputs" = '"bist_done" + "bist_pass" + "rx_data[0]" + "rx_data[1]" + 
    "rx_data[2]" + "rx_data[3]" + "rx_data[4]" + "rx_data[5]" + "rx_data[6]" + 
    "rx_data[7]" + "rx_err" + "rx_valid" + "tx_ready" + "uart_txd" + "scan_out"'
    ;
    "all_ports" = '"all_inputs" + "all_outputs"';
    "_pi" = '"bist_start" + "clk" + "key_in" + "key_load" + "key_sel" + "rst_n" 
    + "scan_en" + "tx_data[0]" + "tx_data[1]" + "tx_data[2]" + "tx_data[3]" + 
    "tx_data[4]" + "tx_data[5]" + "tx_data[6]" + "tx_data[7]" + "tx_valid" + 
    "uart_rxd" + "scan_in"';
    "_po" = '"bist_done" + "bist_pass" + "rx_data[0]" + "rx_data[1]" + 
    "rx_data[2]" + "rx_data[3]" + "rx_data[4]" + "rx_data[5]" + "rx_data[6]" + 
    "rx_data[7]" + "rx_err" + "rx_valid" + "tx_ready" + "uart_txd" + "scan_out"'
    ;
}
